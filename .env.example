# Neon Postgres. Use sslmode=verify-full (same behaviour as require, without the pg warning).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full

# Long random string; signs admin sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Neon Object Storage (S3-compatible). Create a credential in the Neon console for the key pair.
AWS_ENDPOINT_URL_S3=https://BRANCH.storage.c-3.ap-southeast-1.aws.neon.tech
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=kasistorage

# Public site origin used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://kasi.com
